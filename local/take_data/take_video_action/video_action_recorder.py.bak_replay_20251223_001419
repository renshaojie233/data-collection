    def _compute_series_range(self, points, default_min, default_max, min_span):
        """根据数据自动计算显示范围"""
        min_v = None
        max_v = None
        for _, v in points:
            try:
                v = float(v)
            except Exception:
                continue
            if min_v is None or v < min_v:
                min_v = v
            if max_v is None or v > max_v:
                max_v = v
        if min_v is None or max_v is None:
            return default_min, default_max

        span = max_v - min_v
        if span < min_span:
            center = (min_v + max_v) / 2
            span = min_span
            min_v = center - span / 2
            max_v = center + span / 2
        else:
            pad = span * 0.1
            min_v -= pad
            max_v += pad
        return min_v, max_v

