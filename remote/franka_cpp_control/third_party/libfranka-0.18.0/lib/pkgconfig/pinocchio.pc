prefix=/home/rsj/franka_lib/install
exec_prefix=/home/rsj/franka_lib/install
libdir=/home/rsj/franka_lib/install/lib
bindir=/home/rsj/franka_lib/install/bin
pkglibdir=/home/rsj/franka_lib/install/lib/pinocchio
includedir=/home/rsj/franka_lib/install/include
datarootdir=/home/rsj/franka_lib/install/share
pkgdatarootdir=/home/rsj/franka_lib/install/share
docdir=/home/rsj/franka_lib/install/share/doc/pinocchio
